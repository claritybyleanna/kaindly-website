{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-vercel-site.mjs",
  "outputDirectory": ".vercel-static",
  "rewrites": [
    {
      "source": "/api/blead-retention",
      "destination": "/api/workbook-retention"
    },
    {
      "source": "/dashboard/api/auth-config",
      "destination": "/api/dashboard-auth-config"
    },
    {
      "source": "/dashboard/api/responses",
      "destination": "/api/dashboard-responses"
    },
    {
      "source": "/dashboard/api/export.csv",
      "destination": "/api/dashboard-export"
    },
    {
      "source": "/Blead/facilitator/api/responses",
      "destination": "/api/blead-facilitator-responses"
    },
    {
      "source": "/Blead/facilitator/api/export.csv",
      "destination": "/api/blead-facilitator-export"
    },
    {
      "source": "/Blead/api/responses",
      "destination": "/api/workbook-responses-blead"
    },
    {
      "source": "/bsales/prompt-pack-1/api/responses",
      "destination": "/api/workbook-responses-bsales-pack-1"
    },
    {
      "source": "/bsales/prompt-pack-2/api/responses",
      "destination": "/api/workbook-responses-bsales-pack-2"
    },
    {
      "source": "/McLendon/api/responses",
      "destination": "/api/workbook-responses-mclendon"
    },
    {
      "source": "/OWR/api/responses",
      "destination": "/api/blead-responses?workbook=owr-career-architecture"
    },
    {
      "source": "/OWR/next-move/api/responses",
      "destination": "/api/blead-responses?workbook=owr-purposeful-next-move"
    },
    {
      "source": "/dashboard/api/owr-help",
      "destination": "/api/dashboard-responses?view=owr-help"
    },
    {
      "source": "/OWR/next-move/api/connections",
      "destination": "/api/blead-responses?workbook=owr-connections-2026-10-20"
    }
  ],
  "crons": [
    {
      "path": "/api/workbook-retention",
      "schedule": "0 9 * * *"
    }
  ]
}
