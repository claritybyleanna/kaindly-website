{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/maintenance.html",
      "status": 503,
      "headers": {
        "Cache-Control": "no-store, max-age=0",
        "Retry-After": "3600",
        "X-Robots-Tag": "noindex, nofollow"
      }
    }
  ]
}
