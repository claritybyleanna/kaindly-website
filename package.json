{
  "name": "kaindly-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The official Kaindly website.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:blead": "node scripts/build-blead.mjs && node scripts/build-blead-prompts.mjs && node scripts/build-blead-facilitator.mjs",
    "build:bsales": "node scripts/build-bsales.mjs",
    "build:dashboard-auth": "esbuild assets/js/dashboard-auth-entry.js --bundle --format=esm --outfile=assets/js/dashboard-auth.js",
    "build:dashboard": "npm run build:dashboard-auth && node scripts/build-dashboard.mjs",
    "migrate:workbooks": "node --env-file=.env.local scripts/migrate-workbook-db.mjs",
    "migrate:blead": "npm run migrate:workbooks",
    "test": "node --test tests/*.test.mjs",
    "prototype:blead": "npm run build:blead && node scripts/blead-prototype-server.mjs",
    "build:reports": "node scripts/build-reports.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.2",
    "@clerk/clerk-js": "^6.39.0",
    "@clerk/shared": "^4.40.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/functions": "3.9.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
